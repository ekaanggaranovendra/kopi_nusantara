# Ganti bagian database & session pada file .env bawaan Laravel dengan ini.
# Password diisi HANYA di .env (jangan di-commit ke Git).

APP_NAME="Kopi Nusantara"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kopi_nusantara
DB_USERNAME=kopi_user
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
